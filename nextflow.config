includeConfig 'conf/base.config'

manifest {
    name        = 'dda-lfq-proteomics'
    description = 'Memory-conscious DDA label-free quantitative proteomics workflow'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}

params {
    outdir     = 'results'
    smoke      = false
    samplesheet = null
    python     = 'python3'
    fasta      = null
    search_test = false
    philosopher_test = false
    prepare_database = false
    prepare_yeast_database = false
    identify = false
    convert_raw = false
    quantify = false
    analyze = false
    raw = null
    raw_sample = null
    msconvert_bin = null
    quant_manifest = null
    ionquant_jar = null
    msfragger_ext = null
    msfragger_jar = null
    philosopher_bin = null
    msfragger_params = 'conf/msfragger/synthetic-search.params'
    msfragger_xmx = '4G'
    ionquant_xmx = '3G'
    ionquant_mbr = false
    quant_fasta_sha256 = null
    combined_protein = null
    design = null
    identification_summary = null
    analysis_dataset = 'PXD003472'
    ionquant_min_available_gib = 3.5
    ionquant_min_free_disk_gib = 20
    search_min_total_gib = 5.5
    search_min_available_gib = 4.25
    search_min_free_disk_gib = 25
    decoy_prefix = 'rev_'
    database_cache_dir = '.local/databases/UP000005640'
    yeast_database_cache_dir = '.local/databases/UP000002311'
    psm_fdr = 0.01
    peptide_fdr = 0.01
    protein_fdr = 0.01
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        process.executor = 'local'
        docker.enabled   = true
    }

    conda {
        process.executor = 'local'
        conda.enabled    = true
    }
}
