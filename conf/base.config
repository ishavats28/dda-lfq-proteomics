/*
 * Defaults target a small workstation with approximately 8 GB RAM.
 * Individual scientific processes must request only what they need.
 */

process {
    executor      = 'local'
    maxForks      = 1
    errorStrategy = 'terminate'
    maxRetries    = 0

    cpus   = 1
    memory = '2 GB'
    time   = '12 h'

    shell = ['/bin/bash', '-ue']
}

executor {
    queueSize    = 1
    pollInterval = '1 sec'
}

docker {
    enabled    = false
    runOptions = '--cpus 2 --memory 6g'
}

conda {
    enabled = false
}

cleanup = false
